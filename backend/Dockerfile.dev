# ===================================================
# CarePoint Hospital Management System - Backend Dev Dockerfile
# With Node.js file watching and hot reloading
# ===================================================
FROM node:20-alpine

WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy source
COPY . .

ENV NODE_ENV=development
ENV PORT=5000

EXPOSE 5000

CMD ["node", "--watch", "backend/server.js"]
