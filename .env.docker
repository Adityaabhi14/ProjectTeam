# Database Credentials
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=hospital_management_db
DB_USER_PASSWORD=carepoint_pass

# Backend Server Configuration
BACKEND_PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=carepoint_hospital_super_secret_jwt_key_2026
