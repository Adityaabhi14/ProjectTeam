# Register this callback URL in your Google Cloud OAuth 2.0 Web Client first.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback

# These defaults preserve the existing frontend OAuth/PKCE configuration.
AUTH_PUBLIC_URL=http://localhost:5000
AUTH_ISSUER=http://localhost:5000
FRONTEND_REDIRECT_URIS=http://127.0.0.1:5501/,http://localhost:5173/,http://127.0.0.1:5173/
NODE_ENV=development
